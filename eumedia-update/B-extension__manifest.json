{
  "manifest_version": 3,
  "name": "Page · Browser Agent",
  "version": "1.1.9",
  "description": "Kết nối Profile với A, báo trạng thái trình duyệt và nhận lệnh đăng.",
  "permissions": ["storage", "tabs", "alarms", "scripting", "debugger"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://facebook.com/*", "https://www.facebook.com/*", "https://drive.google.com/*", "https://start.adspower.net/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Page · Kết nối A", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://facebook.com/*", "https://www.facebook.com/*"], "js": ["facebook-content.js"] }]
}
